# Tudo aqui é opcional: o site guarda as chaves em data/config.json pela
# página Ajustes. Uma variável preenchida aqui vale por cima do que está lá.
# Copie para .env.local e reinicie o bun dev.

APIFY_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Pasta com os PDFs dos currículos (padrão: data/cvs)
CV_DIR=
